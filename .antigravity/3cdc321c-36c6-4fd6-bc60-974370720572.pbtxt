      replacement_content: "        // Open Settings Buttons\n        item {\n            Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {\n                Button(\n                    onClick = { viewModel.openAccessibilitySettings() },\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .height(50.dp)\n                        .testTag(\"guide_open_settings_button\"),\n                    shape = RoundedCornerShape(16.dp),\n                    colors = ButtonDefaults.buttonColors(containerColor = Teal600)\n                ) {\n                    Text(\n                        text = \"1. Enable Accessibility Service\",\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 15.sp,\n                        color = Color.White\n                    )\n                }\n\n                Button(\n                    onClick = { viewModel.openOverlaySettings() },\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .height(50.dp)\n                        .testTag(\"guide_open_overlay_settings_button\"),\n                    shape = RoundedCornerShape(16.dp),\n                    colors = ButtonDefaults.buttonColors(containerColor = Slate800)\n                ) {\n                    Text(\n                        text = \"2. Allow \'Display Over Other Apps\' (For Pop-ups)\",\n                        fontWeight = FontWeight.SemiBold,\n                        fontSize = 14.sp,\n                        color = Slate100\n                    )\n                }\n            }\n        }"
    }
