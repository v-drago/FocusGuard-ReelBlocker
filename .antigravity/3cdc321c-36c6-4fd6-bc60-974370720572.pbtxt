    replacement_infos {
      original_chunk {
        target_content: "                    Text(\n                        text = \"Because modern apps like Instagram run in sandboxed processes, standard Android digital wellness tools use Android\'s AccessibilityService API to detect when the Reels tab or video container is brought into view.\\n\\nWhen a Reel tab is detected, FocusGuard issues a clean \'Back\' gesture or presents a mindfulness deep-breath overlay to stop the doomscroll loop before it starts.\",\n                        style = MaterialTheme.typography.bodySmall.copy(\n                            color = Color.LightGray,\n                            lineHeight = 20.sp\n                        )\n                    )"
        replacement_content: "                    Text(\n                        text = \"Because modern apps like Instagram run in sandboxed processes, standard Android digital wellness tools use Android\'s AccessibilityService API and System Window Overlays.\\n\\n\342\200\242 Timed Mindfulness Nudge: FocusGuard tracks time spent inside Reels or the Main Feed. When the threshold (e.g. 30s) is reached, a gentle mindfulness overlay pops up prompting you to take a breath or return home.\\n\342\200\242 Smart Back Action: If selected, FocusGuard issues a back gesture with a 30s safety cooldown to prevent repeating loops.\\n\342\200\242 Why Overlays: Android\'s security model prevents external apps from modifying third-party binaries or layouts directly. System Overlays provide the cleanest, safest, and most reliable digital wellbeing solution.\",\n                        style = MaterialTheme.typography.bodySmall.copy(\n                            color = Color.LightGray,\n                            lineHeight = 20.sp\n                        )\n                    )"
      }
      num_matches: 1
    }
  }
